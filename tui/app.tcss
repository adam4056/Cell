/* Cell-2 CLI — Minimal styles */

Screen {
    align: center middle;
}

#chat-log {
    width: 100%;
    height: 1fr;
    border: solid $primary;
    padding: 0 1;
}

#input-row {
    width: 100%;
    height: auto;
    padding: 1 0;
}

#input-row Input {
    width: 100%;
}

/* Permission modal */
.perm-modal {
    width: 60;
    height: auto;
    border: thick $background 80%;
    background: $surface;
    padding: 1 2;
}

.perm-title {
    text-style: bold;
    text-align: center;
    width: 100%;
    margin: 1 0;
}

.perm-op {
    text-align: center;
    width: 100%;
    color: $text-accent;
}

.perm-detail {
    width: 100%;
    margin: 1 0;
    color: $text-disabled;
}

.perm-buttons {
    width: 100%;
    height: auto;
    align: center middle;
    margin: 1 0;
}

.perm-buttons Button {
    margin: 0 1;
}
