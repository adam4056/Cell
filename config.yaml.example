# ── Legacy flat config (still works if no providers map) ─────
# api_base: "https://api.deepseek.com"
# api_key: "sk-..."
# model: "deepseek-chat"
# deepseek_api_key: "sk-..."

# ── Brave Search API key (https://brave.com/search/api/) ──────
brave_search_api_key: ""

# ── Web UI authentication ─────────────────────────────────────
web_auth_token: ""

# ── Ambient agent ─────────────────────────────────────────────
ambient_interval_seconds: 0

# ── MCP servers ──────────────────────────────────────────────
# mcp_servers:
