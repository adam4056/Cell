# ── Multi-provider setup ──────────────────────────────────────
# default_provider is the key from the providers map below.
# If absent, the first provider key is used.
default_provider: "deepseek"

providers:
  deepseek:
    type: "openai_compat"
    api_base: "https://api.deepseek.com"
    api_key: "sk-..."
    model: "deepseek-chat"
    cheap_model: "deepseek-chat"

  # openai:
  #   type: "openai_compat"
  #   api_base: "https://api.openai.com/v1"
  #   api_key: "sk-..."
  #   model: "gpt-4.1"
  #   cheap_model: "gpt-4.1-mini"

  # anthropic:
  #   type: "anthropic"
  #   api_key: "sk-ant-..."
  #   model: "claude-sonnet-4-20250514"
  #   cheap_model: "claude-haiku-3-5-20241022"

  # gemini:
  #   type: "gemini"
  #   api_key: "..."
  #   model: "gemini-2.5-pro"
  #   cheap_model: "gemini-2.5-flash"

  # local:
